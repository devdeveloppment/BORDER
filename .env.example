# Environnement Docker Compose de développement RBI.
# Ne jamais commiter de fichier .env. Créer (ou compléter) le vôtre avec :
#   py scripts/init_env.py
# qui recopie ce modèle et remplace chaque valeur __GENERATE__ par un secret aléatoire.
# Sur un .env existant, seules les variables manquantes sont ajoutées ; les secrets en place sont conservés.

# --- Django ------------------------------------------------------------------
RBI_DJANGO_SECRET_KEY=__GENERATE__
# Point d'entrée unique (Nginx, P2.10) : http://127.0.0.1:8080 — frontend et API sur la même origine.
RBI_HTTP_HOST_PORT=8080
# Port direct de l'API : uniquement avec infra/compose.host-ports.yml (débogage).
RBI_API_HOST_PORT=8000

# --- PostgreSQL 16 + PostGIS -------------------------------------------------
# Superutilisateur d'amorçage : initialisation du cluster uniquement, jamais transmis à l'application.
POSTGRES_SUPERUSER=rbi_superuser
POSTGRES_SUPERUSER_PASSWORD=__GENERATE__
RBI_DB_NAME=rbi
# Propriétaire des tables : migrations uniquement.
RBI_DB_OWNER=rbi_owner
RBI_DB_OWNER_PASSWORD=__GENERATE__
# Rôle applicatif (API, Celery) : non propriétaire, soumis au Row-Level Security.
RBI_DB_APP_USER=rbi_app
RBI_DB_APP_PASSWORD=__GENERATE__
# 5433 par défaut : 5432 est souvent occupé par un PostgreSQL local.
RBI_DB_HOST_PORT=5433

# --- Redis 7 -----------------------------------------------------------------
REDIS_PASSWORD=__GENERATE__
RBI_REDIS_HOST_PORT=6379

# --- Stockage objet compatible S3 (SeaweedFS) --------------------------------
RBI_S3_ACCESS_KEY=__GENERATE__
RBI_S3_SECRET_KEY=__GENERATE__
RBI_S3_BUCKET=rbi-dev
RBI_S3_HOST_PORT=8333

# --- Mailpit (capture des e-mails, aucun envoi réel) --------------------------
RBI_MAILPIT_SMTP_HOST_PORT=1025
RBI_MAILPIT_UI_HOST_PORT=8025

# --- Proxy (P2.10, ADR 0012) ---------------------------------------------------------------------------
# Réseau « edge » : Nginx a une adresse fixe, seule déclarée comme proxy de confiance (RBI_TRUSTED_PROXIES).
# À changer seulement en cas de conflit avec un réseau existant (les trois valeurs ensemble).
RBI_EDGE_SUBNET=172.29.89.0/28
RBI_EDGE_PROXY_IP=172.29.89.2
RBI_EDGE_DYNAMIC_RANGE=172.29.89.8/29
