# Mode de l'API (P2.10, ADR 0012) :
#   true (ou absent) : tout simulé par MSW (maquette Phase 1) ;
#   deferred         : API réelle derrière Nginx, MSW pour les seuls modules métier reportés (pile intégrée) ;
#   false            : API réelle uniquement.
# En production (VITE_APP_ENV=production), les mocks sont exclus du bundle quelle que soit cette valeur.
VITE_API_MOCKS=true
# Environnement affiché dans le bandeau : demo | staging | production
VITE_APP_ENV=demo
